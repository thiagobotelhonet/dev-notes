{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window. No static fs scope and no fs:allow-remove: the vault folder is allowed at runtime by vault_pick/vault_restore, and nothing is ever deleted for good (research R3).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "allow-vault-pick",
    "allow-vault-restore",
    "allow-vault-scan",
    "allow-vault-read-notes",
    "allow-vault-trash",
    "allow-vault-app-data-read",
    "allow-vault-app-data-write"
  ]
}
